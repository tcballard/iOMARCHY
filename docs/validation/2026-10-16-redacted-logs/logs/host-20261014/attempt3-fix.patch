diff --git i/scripts/boot.sh w/scripts/boot.sh
index 5d92d20..eb348d3 100755
--- i/scripts/boot.sh
+++ w/scripts/boot.sh
@@ -20,7 +20,9 @@ command -v bwrap >/dev/null || fail 'Install bubblewrap.'
 exec 9>"$ROOT/build/boot.lock"
 flock -n 9 || fail 'Another boot session is already running.'
 run=$(mktemp -d "$ROOT/logs/boot-$(date +%Y%m%d-%H%M%S)-XXXX")
-usbroot=$(mktemp -d /tmp/j96-usb-XXXX)
+# Bind mounts retain nodev from their source. /tmp is commonly nodev, which
+# makes mirrored USB nodes unusable even as root inside --dev-bind.
+usbroot=$(mktemp -d /dev/j96-usb-XXXX)
 child=''
 cleanup() {
     [[ -z $child ]] || kill -- "-$child" 2>/dev/null || true
@@ -84,6 +86,10 @@ printf 'Identified J96, ECID %s, USB port %s\n' "$expected" "${port##*/}"
 printf '%s\n' "$expected" > "$run/ecid.txt"
 if [[ $product != 1227 && $product != 4141 ]]; then
     printf '\nDFU: screen must end completely black. Cable/iTunes graphic is recovery.\n'
+    printf 'Read the whole sequence first; the timer starts only after Enter:\n'
+    printf '  1. Hold Top/Power alone for 3 seconds.\n'
+    printf '  2. Keep Top/Power held and add Home for 8 seconds.\n'
+    printf '  3. Release only Top/Power; hold Home until DFU is verified.\n'
     printf 'Press Enter when ready for the timed Home + Top/Power sequence.\n'
     read -r
     printf 'Hold Top/Power now (3 seconds).\n'; sleep 3
diff --git i/scripts/check-host.sh w/scripts/check-host.sh
index 20b3cae..eb51ffa 100755
--- i/scripts/check-host.sh
+++ w/scripts/check-host.sh
@@ -63,8 +63,22 @@ if [[ $device == 1 ]]; then
         echo 'Runtime tools and requested artifacts checked; USB driver and namespaces not tested.'
         exit 0
     fi
-    # Validate namespace support without enumerating or exposing USB devices.
-    bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --unshare-pid --die-with-parent /bin/true
+    # Exercise the actual device-node mount without enumerating/exposing USB.
+    # /bin/true alone misses nodev inherited from a staging directory on /tmp.
+    [[ $EUID == 0 ]] || { echo 'Run device namespace checks with sudo (or use start.sh --check).'; exit 1; }
+    probe=$(mktemp -d /dev/j96-check-XXXX)
+    cleanup_probe() {
+        find "$probe" -type c -delete
+        find "$probe" -depth -type d -empty -delete
+    }
+    trap cleanup_probe EXIT
+    mkdir "$probe/001"
+    mknod -m 0600 "$probe/001/001" c 1 3 # harmless /dev/null, not a USB device
+    bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /run \
+        --dev-bind "$probe" /dev/bus/usb --unshare-pid --die-with-parent \
+        /bin/sh -c ': < /dev/bus/usb/001/001; : > /dev/bus/usb/001/001'
+    cleanup_probe
+    trap - EXIT
     echo 'Device-host readiness checks passed. No device interaction performed.'
 else
     echo 'Build-host checks passed. Device tools, USB drivers and namespace access were not checked.'
