#!/bin/bash
# Emulator diagnostic. Success means a virtual output, never the iPad panel.
set -u
export HOME=/home/ioprobe XDG_RUNTIME_DIR=/run/user/1000
export PATH=/usr/share/omarchy/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
export OMARCHY_PATH=/usr/share/omarchy XDG_SESSION_TYPE=wayland
export LIBSEAT_BACKEND=seatd SEATD_SOCK=/run/seatd.sock
export LIBGL_ALWAYS_SOFTWARE=1 AQ_NO_KMS_REQUIREMENT=1 HYPRLAND_NO_SD_VARS=1
mkdir -p "$HOME/.cache/hyprland"
# Both legacy .conf and Lua config are supported by the pinned Hyprland 0.56.2.
# This compositor probe deliberately has no user autostart/provisioning hooks.
dbus-run-session -- Hyprland --config /etc/iomarchy/headless.conf > "$XDG_RUNTIME_DIR/hyprland.log" 2>&1 &
compositor=$!
trap 'kill "$compositor" 2>/dev/null || :' EXIT
ready=0
for ((attempt=0; attempt<30; attempt++)); do
    if ! kill -0 "$compositor" 2>/dev/null; then break; fi
    for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
        [[ -S $socket ]] || continue
        export WAYLAND_DISPLAY="${socket##*/}"
        ready=1
        break
    done
    ((ready)) && break
    sleep 1
done
if (( ! ready )); then
    cat "$XDG_RUNTIME_DIR/hyprland.log"
    printf 'IOMARCHY_QEMU_SESSION_BLOCKED no Wayland socket\n'
    exit 2
fi
printf 'IOMARCHY_QEMU_COMPOSITOR_SOCKET %s\n' "$WAYLAND_DISPLAY"
instance=$(find "$XDG_RUNTIME_DIR/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -1)
export HYPRLAND_INSTANCE_SIGNATURE="$instance"
# Hyprland creates the Wayland socket before EGL and its control socket are
# ready. Allow software-renderer startup to finish before judging the output.
ready=0
for ((attempt=0; attempt<60; attempt++)); do
    if ! kill -0 "$compositor" 2>/dev/null; then break; fi
    if hyprctl -j monitors > "$XDG_RUNTIME_DIR/monitors.json" 2>&1 &&
        jq -e 'type == "array" and length > 0' "$XDG_RUNTIME_DIR/monitors.json" >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
if (( ! ready )); then
    cat "$XDG_RUNTIME_DIR/monitors.json" "$XDG_RUNTIME_DIR/hyprland.log"
    printf 'IOMARCHY_QEMU_SESSION_BLOCKED output query did not become ready\n'
    exit 3
fi
printf 'IOMARCHY_QEMU_COMPOSITOR_PASS\n'
cat "$XDG_RUNTIME_DIR/monitors.json"
if grep -qw 'iomarchy.visual=1' /proc/cmdline; then
    rm -f "$XDG_RUNTIME_DIR/visual-key-received"
    foot --config=/dev/null --app-id=iomarchy-visual --title=iomarchy-visual \
        /usr/local/sbin/iomarchy-visual-client > "$XDG_RUNTIME_DIR/foot.log" 2>&1 &
    terminal=$!
    printf 'IOMARCHY_QEMU_VISUAL_READY\n'
    # The host captures pixels and injects x followed by q through QMP.
    for ((attempt=0; attempt<100; attempt++)); do
        kill -0 "$terminal" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$terminal" 2>/dev/null || [[ ! -f $XDG_RUNTIME_DIR/visual-key-received ]]; then
        kill "$terminal" 2>/dev/null || :
        cat "$XDG_RUNTIME_DIR/foot.log" "$XDG_RUNTIME_DIR/hyprland.log"
        printf 'IOMARCHY_QEMU_VISUAL_BLOCKED\n'
        exit 6
    fi
    wait "$terminal" || { cat "$XDG_RUNTIME_DIR/foot.log"; exit 6; }
fi
# Attempt the real upstream shell, not a substitute themed status bar.
qs --path /usr/share/omarchy/shell > "$XDG_RUNTIME_DIR/quickshell.log" 2>&1 &
shell=$!
sleep 10
if kill -0 "$shell" 2>/dev/null; then
    printf 'IOMARCHY_QEMU_SHELL_PROCESS_ALIVE (visual usability unverified)\n'
    result=0
    printf 'IOMARCHY_QEMU_SHELL_CAPTURE_READY\n'
    sleep 10
else
    printf 'IOMARCHY_QEMU_SHELL_BLOCKED\n'
    result=4
fi
cat "$XDG_RUNTIME_DIR/quickshell.log" "$XDG_RUNTIME_DIR/hyprland.log"
kill "$shell" 2>/dev/null || :
exit "$result"
